@echo off
rem Build the one-click installer (WinForms) with the C# compiler bundled in Windows (.NET Framework 4.x).
setlocal
set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"
if not exist "%CSC%" (
  echo csc.exe not found. .NET Framework 4.x is required.
  exit /b 1
)
cd /d "%~dp0"
if not exist "..\dist" mkdir "..\dist"
rem assets\mascot.png, assets\panda.png and assets\app.ico are generated by assets\prepare_assets.py
"%CSC%" /nologo /codepage:65001 /target:winexe /platform:anycpu /optimize+ /r:System.Windows.Forms.dll /r:System.Drawing.dll /win32icon:assets\app.ico /resource:assets\mascot.png,mascot.png /resource:assets\panda.png,panda.png /resource:assets\app.ico,app.ico /out:"..\dist\DafeiyuInstaller.exe" DafeiyuInstaller.cs InstallerUi.cs
if errorlevel 1 exit /b 1
echo Built: %~dp0..\dist\DafeiyuInstaller.exe
